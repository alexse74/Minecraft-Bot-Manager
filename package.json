
{
  "name": "minecraft-bot-manager",
  "version": "1.1.0",
  "description": "Interface de gestion d'un bot Minecraft",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@wp2508/mineflayer": "^4.42.7",
    "mineflayer-pathfinder": "^2.4.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.minecraftbot.manager",
    "productName": "Minecraft Bot Manager",
    "directories": {
      "output": "dist"
    },
	"files": [
	  "main.js",
	  "preload.js",
	  "renderer.js",
	  "index.html",
	  "style.css",
	  "bot.js",
	  "assets/**/*",
	  "node_modules/**/*",
	  "package.json"
	],

	"win": {
	  "target": "nsis",
	  "icon": "assets/icon.ico"
	},

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
